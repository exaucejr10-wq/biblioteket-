// Film ärver från Biblioteksmedia men implementerar INTE IUtlaningsbar.
public class Film : Biblioteksmedia
{
    public int SpeltidMinuter { get; set; }

    // Titel och utgivningsår skickas till basklassen,
    // speltiden tar filmens egen konstruktor hand om.
    public Film(string titel, int utgivningsar, int speltidMinuter)
        : base(titel, utgivningsar)
    {
        SpeltidMinuter = speltidMinuter;
    }

    public override string Beskrivning()
    {
        return $"{Titel} ({Utgivningsar}), {SpeltidMinuter} min";
    }
}